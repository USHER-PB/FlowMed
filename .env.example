# Database
DATABASE_URL="mysql://healthuser:healthpass@localhost:3306/healthapp"

# Redis
REDIS_URL="redis://localhost:6380"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Encryption (must be 32 characters for AES-256)
ENCRYPTION_KEY="your-32-character-encryption-key!!"

# App
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# SMS (future)
# SMS_API_KEY=""
# SMS_SENDER_ID=""

# Resend Email Service
RESEND_API_KEY="your-resend-api-key"
# Optional: Custom sender email (requires domain verification in Resend)
# RESEND_FROM_EMAIL="FlowMed <noreply@yourdomain.com>"
# If not set, uses Resend's testing domain: onboarding@resend.dev

# Admin/Support Email (where contact form messages are sent)
ADMIN_EMAIL="your-email@gmail.com"

# File Storage (future)
# STORAGE_BUCKET=""
# STORAGE_REGION=""
